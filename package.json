{
  "name": "rig-c",
  "version": "2.34.0",
  "description": "AI-authored Spine 2D rigging and animation, verified before it is written. rigc compiles a rig spec into Spine 4.3 skeleton data, gates it with named assertions held to a spine-core round trip's verdicts, and emits nothing that fails. Output imports into the Spine editor. Ships as an agent skill.",
  "type": "module",
  "bin": {
    "rigc": "./bin/rigc.cjs"
  },
  "exports": {
    "./plate": "./tools/plate.ts",
    "./font5x7": "./tools/font5x7.ts",
    "./transform": "./src/transform.ts",
    "./render": "./src/render.ts",
    "./png": "./src/png.ts",
    "./compile": "./src/compile.ts",
    "./rig": "./src/rig.ts",
    "./mesh": "./src/mesh.ts",
    "./errors": "./src/errors.ts",
    "./meshcompare": "./src/meshcompare.ts",
    "./core": "./src/core/entry.ts",
    "./cli": "./cli.ts",
    "./package.json": "./package.json",
    "./*.ts": "./*.ts",
    "./*.mjs": "./*.mjs",
    "./*.cjs": "./*.cjs",
    "./*.json": "./*.json",
    "./*.md": "./*.md",
    "./LICENSE": "./LICENSE",
    "./bin/rigc": "./bin/rigc.cjs",
    "./tools/png_probe": "./tools/png_probe.mjs",
    "./*": "./*.ts"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "license": "MIT",
  "author": "firejune",
  "repository": {
    "type": "git",
    "url": "https://github.com/firejune/rigc.git"
  },
  "homepage": "https://github.com/firejune/rigc#readme",
  "bugs": "https://github.com/firejune/rigc/issues",
  "keywords": [
    "spine",
    "spine2d",
    "skeletal-animation",
    "rig",
    "compiler",
    "skeleton-json",
    "atlas",
    "validator",
    "codegen",
    "ai-agents",
    "cli",
    "spine-2d",
    "ai",
    "animation",
    "rigging",
    "agent-skill",
    "claude"
  ],
  "files": [
    "bin/rigc.cjs",
    "cli.ts",
    "cli_core.ts",
    "src",
    "tools/plate.ts",
    "tools/font5x7.ts",
    "tools/contact.ts",
    "tools/png_probe.mjs",
    "tools/measure_contact_depth.ts",
    "tools/editor_roundtrip.ts",
    "docs/AUTHORING.md",
    "docs/SPEC_COVERAGE.md",
    "docs/PROMPTING.md",
    "docs/RIGGING.md",
    "docs/MOTION.md",
    "docs/INGEST.md",
    "docs/FACE.md",
    "NOTICE.md",
    ".claude-plugin",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun cli.ts build",
    "validate": "bun cli.ts validate",
    "explain": "bun cli.ts explain",
    "selftest": "bun selftest.ts",
    "smoke": "bun scripts/install_smoke.ts",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:runs": "bunx tsc --noEmit -p tsconfig.runs.json",
    "lint": "bunx eslint .",
    "fetch-examples": "bash scripts/fetch-examples.sh",
    "bench:usage": "bun bench/count_features.ts",
    "viewer": "vite --config viewer/vite.config.ts",
    "prepublishOnly": "bun scripts/prepublish_gate.ts"
  },
  "devDependencies": {
    "@esotericsoftware/spine-core": "4.3.13",
    "@types/bun": "^1.4.0",
    "eslint": "^10.9.0",
    "spine-html": "^0.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}

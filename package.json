{
  "name": "spine-rigc",
  "version": "0.12.0",
  "description": "Rig compiler for Spine — declarative rig specs in, Spine 4.3 skeleton data out, verified by a spine-core round-trip. Built so AI agents can author rigs and check their own work; the output imports into the Spine editor.",
  "type": "module",
  "bin": {
    "rigc": "./bin/rigc.cjs"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "license": "MIT",
  "author": "firejune",
  "repository": {
    "type": "git",
    "url": "https://github.com/firejune/rigc.git"
  },
  "homepage": "https://github.com/firejune/rigc#readme",
  "bugs": "https://github.com/firejune/rigc/issues",
  "keywords": [
    "spine",
    "spine2d",
    "skeletal-animation",
    "rig",
    "compiler",
    "skeleton-json",
    "atlas",
    "validator",
    "codegen",
    "ai-agents",
    "cli"
  ],
  "files": [
    "bin/rigc.cjs",
    "cli.ts",
    "src",
    "tools/plate.ts",
    "tools/font5x7.ts",
    "tools/contact.ts",
    "tools/png_probe.mjs",
    "tools/measure_contact_depth.ts",
    "docs/AUTHORING.md",
    "docs/SPEC_COVERAGE.md",
    "docs/PROMPTING.md",
    "docs/MOTION.md",
    "docs/INGEST.md",
    "docs/FACE.md",
    "NOTICE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun cli.ts build",
    "validate": "bun cli.ts validate",
    "explain": "bun cli.ts explain",
    "selftest": "bun selftest.ts",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:runs": "bunx tsc --noEmit -p tsconfig.runs.json",
    "lint": "bunx eslint .",
    "fetch-examples": "bash scripts/fetch-examples.sh",
    "bench:usage": "bun bench/count_features.ts",
    "viewer": "vite --config viewer/vite.config.ts",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run selftest"
  },
  "dependencies": {
    "@esotericsoftware/spine-core": "4.3.13"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "eslint": "^10.9.0",
    "spine-html": "^0.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}

{
  // Type-check only. Bun runs the .ts sources directly, so nothing here emits —
  // `bun run typecheck` exists to catch what the runtime would hit later, and to
  // make `no-explicit-any` mean something (see eslint.config.js).
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["bun"],

    // `.ts` in relative imports is this project's convention and Bun's default;
    // TypeScript allows it only when nothing is emitted.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // ⚠️ Not full `strict`, on purpose. The code is written against
    // `strictNullChecks` — the compiler leans on `x === undefined` narrowing all
    // over — and turning on the rest (`noImplicitAny`, `strictFunctionTypes`,
    // `strictPropertyInitialization`) would be a refactor, not a gate. Raise it
    // when somebody is prepared to do that work; do not raise it silently.
    "strict": false,
    "strictNullChecks": true
  },
  "include": ["cli.ts", "selftest.ts", "src/**/*.ts", "bench/**/*.ts", "tools/**/*.ts", "fixtures/**/*.ts", "scripts/**/*.ts"],
  // `bench/runs/**` is out of this surface, systematically rather than case by
  // case — see issue #201. Everything under it is a run's committed record
  // (bench/runs/README.md's *After a run*: final once landed, editable only by
  // a labelled amendment commit, per #181), so a type error in one cannot be
  // fixed the ordinary way regardless — it needs an amendment or an exclusion
  // either way, and this exclusion is the standing answer. The boundary: a run's
  // tooling is checked when it is written (an author typechecks their own
  // harness while authoring it — `bun run typecheck:runs` covers a landed run on
  // demand), archived thereafter — it does not sit in the repo-wide gate, so a
  // future change to `src/` cannot red a dozen harnesses nobody will run again,
  // and the surface does not grow with every run the ladder completes. This
  // replaces the single ad-hoc entry that used to live here for
  // `bench/runs/2026-08-24-rung3-1` (landed in #150, the first external pilot
  // run — a hallucinated spine-core call in an abandoned helper).
  "exclude": ["node_modules", "examples", "bench/runs/**"]
}

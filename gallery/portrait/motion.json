  "groups": {
    "lids": ["lid_l", "lid_r"],
    "brows": ["brow_l", "brow_r"],
    "irises": ["iris_l", "iris_r"],
    "sparks": ["spark_l", "spark_r"],
    "axis": ["nose", "mouth"],
    "look_l": ["iris_l", "spark_l"],
    "look_r": ["iris_r", "spark_r"]

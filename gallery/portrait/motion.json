{
  "spec": "rigc-motion/1",
  "archetype": "portrait",
  "cut": "gallery-portrait",

  "easings": {
    "rise": [0.4, 0, 0.86, 0.38],
    "settle": [0.12, 0.7, 0.3, 1],
    "swell": [0.42, 0, 0.58, 1]
  },

  "groups": {
    "lids": ["lid_l", "lid_r"],
    "brows": ["brow_l", "brow_r"],
    "irises": ["iris_l", "iris_r"],
    "sparks": ["spark_l", "spark_r"],
    "features": ["eye_l", "eye_r", "brow_l", "brow_r", "nose", "mouth"],
    "hair": ["hairmass", "lock_l", "lock_r", "ahoge"],
    "look_l": ["iris_l", "spark_l"],
    "look_r": ["iris_r", "spark_r"]
  },

  "animations": {
    "idle": {
      "duration": 3.2,
      "loop": true,
      "note": "One breath in 3.2 s and one blink inside it. The breath is a scale on the torso plate's own bone and a translate on a SIBLING bone that carries the head, so the chest swells without the head growing with it. The blink is a lid part sliding 65 units down its own bone — 0.07 s shut, 0.16 s open, which is the asymmetry a stepped attachment swap cannot carry. Hair and cowlick trail the breath at +22%, +25% and +30% of the cycle and overshoot once, per MOTION.md 3.7.",

      "tracks": [
        {
          "bone": "torso",
          "property": "scale",
          "keys": [
            { "t": 0, "v": [1, 1], "ease": "swell" },
            { "t": 1.55, "v": [1.005, 1.014], "ease": "swell" },
            { "t": 3.2, "v": [1, 1] }
          ]
        },
        {
          "bone": "chest",
          "property": "translatey",
          "keys": [
            { "t": 0, "v": [0], "ease": "swell" },
            { "t": 1.55, "v": [3.4], "ease": "swell" },
            { "t": 3.2, "v": [0] }
          ]
        },

        {
          "bone": "headroll",
          "property": "rotate",
          "keys": [
            { "t": 0, "v": [0], "ease": "swell" },
            { "t": 1.15, "v": [0.55], "ease": "settle" },
            { "t": 2.4, "v": [-0.4], "ease": "rise" },
            { "t": 3.2, "v": [0] }
          ]
        },
        {
          "bone": "neck",
          "property": "rotate",
          "keys": [
            { "t": 0, "v": [0], "ease": "swell" },
            { "t": 1.5, "v": [0.3], "ease": "settle" },
            { "t": 2.72, "v": [-0.2], "ease": "rise" },
            { "t": 3.2, "v": [0] }
          ]
        },

        {
          "group": "lids",
          "property": "translatey",
          "keys": [
            { "t": 0, "v": [0] },
            { "t": 1.05, "v": [0], "ease": "rise" },
            { "t": 1.12, "v": [-65], "ease": "rise" },
            { "t": 1.16, "v": [-65], "ease": "settle" },
            { "t": 1.32, "v": [0] },
            { "t": 3.2, "v": [0] }
          ]
        },
        {
          "group": "brows",
          "property": "translatey",
          "keys": [
            { "t": 0, "v": [0] },
            { "t": 1.1, "v": [0], "ease": "rise" },
            { "t": 1.26, "v": [1.8], "ease": "settle" },
            { "t": 1.54, "v": [0] },
            { "t": 3.2, "v": [0] }
          ]
        },

        {
          "bone": "lock_l",
          "property": "rotate",
          "keys": [
            { "t": 0, "v": [0], "ease": "swell" },
            { "t": 2.27, "v": [1.1], "ease": "settle" },
            { "t": 2.86, "v": [-0.4], "ease": "rise" },
            { "t": 3.2, "v": [0] }
          ]
        },
        {
          "bone": "lock_r",
          "property": "rotate",
          "keys": [
            { "t": 0, "v": [0], "ease": "swell" },
            { "t": 2.35, "v": [-1], "ease": "settle" },
            { "t": 2.9, "v": [0.38], "ease": "rise" },
            { "t": 3.2, "v": [0] }
          ]
        },
        {
          "bone": "ahoge",
          "property": "rotate",
          "keys": [
            { "t": 0, "v": [0], "ease": "swell" },
            { "t": 2.5, "v": [2.6], "ease": "settle" },
            { "t": 2.98, "v": [-0.9], "ease": "rise" },
            { "t": 3.2, "v": [0] }
          ]
        }
      ]
    },

    "gaze": {
      "duration": 1.5,
      "loop": false,
      "note": "Eyes lead, head follows, hair overlaps, and everything returns to rest. The iris flicks to its target in 0.22 s; the specular highlight travels 40% as far, because a reflection is fixed to the light and not to the eyeball. The head's follow at +12% of the duration is a rigid slide and a 1.2 deg roll rather than a small yaw — a yaw would need a second deform table, and README.md prices that. Hair and cowlick trail the head at +21%, +24% and +28% and overshoot.",

      "tracks": [
        {
          "group": "irises",
          "property": "translate",
          "keys": [
            { "t": 0, "v": [0, 0], "ease": "rise" },
            { "t": 0.22, "v": [7, -3], "ease": "swell" },
            { "t": 1.02, "v": [7, -3], "ease": "settle" },
            { "t": 1.5, "v": [0, 0] }
          ]
        },
        {
          "group": "sparks",
          "property": "translate",
          "keys": [
            { "t": 0, "v": [0, 0], "ease": "rise" },
            { "t": 0.22, "v": [2.8, -1.2], "ease": "swell" },
            { "t": 1.02, "v": [2.8, -1.2], "ease": "settle" },
            { "t": 1.5, "v": [0, 0] }
          ]
        },

        {
          "bone": "headroll",
          "property": "translatex",
          "keys": [
            { "t": 0, "v": [0], "ease": "rise" },
            { "t": 0.4, "v": [3.4], "ease": "swell" },
            { "t": 1.02, "v": [3.4], "ease": "settle" },
            { "t": 1.5, "v": [0] }
          ]
        },
        {
          "bone": "headroll",
          "property": "rotate",
          "keys": [
            { "t": 0, "v": [0], "ease": "rise" },
            { "t": 0.4, "v": [-1.2], "ease": "swell" },
            { "t": 1.02, "v": [-1.2], "ease": "settle" },
            { "t": 1.5, "v": [0] }
          ]
        },
        {
          "group": "brows",
          "property": "translatey",
          "keys": [
            { "t": 0, "v": [0], "ease": "rise" },
            { "t": 0.34, "v": [1.8], "ease": "swell" },
            { "t": 1.02, "v": [1.8], "ease": "settle" },
            { "t": 1.5, "v": [0] }
          ]
        },

        {
          "bone": "lock_l",
          "property": "rotate",
          "keys": [
            { "t": 0, "v": [0], "ease": "rise" },
            { "t": 0.72, "v": [-1.5], "ease": "settle" },
            { "t": 1.2, "v": [0.55], "ease": "rise" },
            { "t": 1.5, "v": [0] }
          ]
        },
        {
          "bone": "lock_r",
          "property": "rotate",
          "keys": [
            { "t": 0, "v": [0], "ease": "rise" },
            { "t": 0.76, "v": [-1.9], "ease": "settle" },
            { "t": 1.24, "v": [0.7], "ease": "rise" },
            { "t": 1.5, "v": [0] }
          ]
        },
        {
          "bone": "ahoge",
          "property": "rotate",
          "keys": [
            { "t": 0, "v": [0], "ease": "rise" },
            { "t": 0.82, "v": [-2.4], "ease": "settle" },
            { "t": 1.28, "v": [0.9], "ease": "rise" },
            { "t": 1.5, "v": [0] }
          ]
        }
      ]
    },

    "turn": {
      "duration": 2.2,
      "loop": false,
      "note": "A 12 deg yaw, held, and released. Every number in it is one line of arithmetic on dx = x (cos t - 1) - z sin t, the projection of a yaw about the skull's axis — so the spec states that line and the depths it reads, and the compiler states the numbers (AUTHORING 4.5.1). The two mesh deforms carry the face and fringe plates; `faceshift` carries the shift every feature shares; the `features` group carries each feature's parallax, which is its depth BELOW the skull surface times sin t; the `hair` group carries the parts that hang off the head instead, where `hairmass` at depth -55 is behind the axis and therefore swings the OTHER way. The anticipation lives in `headroll`'s roll and not in the yaw, because a yaw anticipation costs a whole 50-number deform key. The iris and its highlight keep the RECIPROCAL of their socket's scaleX and that one is NOT derived: a counter-scale belongs to the socket rather than to the part, which is why `spark_l` at local x -11 takes the same number as `iris_l` at 0 — a shared value on a group is the correct statement of it. README.md derives all of it and measures where it stops reading.",

      "tracks": [
        {
          "bone": "faceshift",
          "property": "translatex",
          "keys": [
            { "t": 0, "v": [0], "ease": "rise" },
            { "t": 0.62, "derive": { "kind": "yaw", "degrees": 12, "depth": 170 }, "ease": "swell" },
            { "t": 1.5, "derive": { "kind": "yaw", "degrees": 12, "depth": 170 }, "ease": "settle" },
            { "t": 2.2, "v": [0] }
          ]
        },

        {
          "group": "features",
          "property": "translatex",
          "keys": [
            { "t": 0, "v": [0], "ease": "rise" },
            {
              "t": 0.62,
              "derive": {
                "kind": "yaw",
                "degrees": 12,
                "carried": 170,
                "depth": { "eye_l": 150, "eye_r": 150, "brow_l": 158, "brow_r": 158, "nose": 192, "mouth": 166 }
              },
              "ease": "swell"
            },
            {
              "t": 1.5,
              "derive": {
                "kind": "yaw",
                "degrees": 12,
                "carried": 170,
                "depth": { "eye_l": 150, "eye_r": 150, "brow_l": 158, "brow_r": 158, "nose": 192, "mouth": 166 }
              },
              "ease": "settle"
            },
            { "t": 2.2, "v": [0] }
          ]
        },
        {
          "group": "features",
          "property": "scalex",
          "keys": [
            { "t": 0, "v": [1], "ease": "rise" },
            {
              "t": 0.62,
              "derive": {
                "kind": "yaw",
                "degrees": 12,
                "depth": { "eye_l": 150, "eye_r": 150, "brow_l": 158, "brow_r": 158, "nose": 192, "mouth": 166 }
              },
              "ease": "swell"
            },
            {
              "t": 1.5,
              "derive": {
                "kind": "yaw",
                "degrees": 12,
                "depth": { "eye_l": 150, "eye_r": 150, "brow_l": 158, "brow_r": 158, "nose": 192, "mouth": 166 }
              },
              "ease": "settle"
            },
            { "t": 2.2, "v": [1] }
          ]
        },

        {
          "group": "look_l",
          "property": "scalex",
          "keys": [
            { "t": 0, "v": [1], "ease": "rise" },
            { "t": 0.62, "v": [1.1208], "ease": "swell" },
            { "t": 1.5, "v": [1.1208], "ease": "settle" },
            { "t": 2.2, "v": [1] }
          ]
        },
        {
          "group": "look_r",
          "property": "scalex",
          "keys": [
            { "t": 0, "v": [1], "ease": "rise" },
            { "t": 0.62, "v": [0.9398], "ease": "swell" },
            { "t": 1.5, "v": [0.9398], "ease": "settle" },
            { "t": 2.2, "v": [1] }
          ]
        },

        {
          "group": "hair",
          "property": "translatex",
          "keys": [
            { "t": 0, "v": [0], "ease": "rise" },
            {
              "t": 0.62,
              "derive": {
                "kind": "yaw",
                "degrees": 12,
                "depth": { "hairmass": -55, "lock_l": 100, "lock_r": 100, "ahoge": 20 }
              },
              "ease": "swell"
            },
            {
              "t": 1.5,
              "derive": {
                "kind": "yaw",
                "degrees": 12,
                "depth": { "hairmass": -55, "lock_l": 100, "lock_r": 100, "ahoge": 20 }
              },
              "ease": "settle"
            },
            { "t": 2.2, "v": [0] }
          ]
        },
        {
          "bone": "neck",
          "property": "translatex",
          "keys": [
            { "t": 0, "v": [0], "ease": "rise" },
            { "t": 0.62, "v": [-10], "ease": "swell" },
            { "t": 1.5, "v": [-10], "ease": "settle" },
            { "t": 2.2, "v": [0] }
          ]
        },

        {
          "bone": "headroll",
          "property": "rotate",
          "keys": [
            { "t": 0, "v": [0], "ease": "rise" },
            { "t": 0.26, "v": [-0.9], "ease": "rise" },
            { "t": 0.62, "v": [1.6], "ease": "swell" },
            { "t": 1.5, "v": [1.6], "ease": "settle" },
            { "t": 2.2, "v": [0] }
          ]
        }
      ],

      "deform": [
        {
          "slot": "head",
          "attachment": "head",
          "keys": [
            { "t": 0, "ease": "rise" },
            { "t": 0.62, "transform": { "kind": "yaw", "radius": 170, "degrees": 12 }, "ease": "swell" },
            { "t": 1.5, "transform": { "kind": "yaw", "radius": 170, "degrees": 12 }, "ease": "settle" },
            { "t": 2.2 }
          ]
        },
        {
          "slot": "hair_bang",
          "attachment": "hair_bang",
          "keys": [
            { "t": 0, "ease": "rise" },
            { "t": 0.62, "transform": { "kind": "yaw", "radius": 196, "degrees": 12 }, "ease": "swell" },
            { "t": 1.5, "transform": { "kind": "yaw", "radius": 196, "degrees": 12 }, "ease": "settle" },
            { "t": 2.2 }
          ]
        }
      ]
    }
  }
}

{
  "spec": "rigc-motion/1",
  "archetype": "portrait",
  "cut": "gallery-portrait",

  "easings": {
    "rise": [0.4, 0, 0.86, 0.38],
    "settle": [0.12, 0.7, 0.3, 1],
    "swell": [0.42, 0, 0.58, 1]

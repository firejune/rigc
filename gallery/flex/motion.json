        {
          "bone": "hinge_a",
          "property": "rotate",
          "keys": [
            { "t": 0, "v": [0], "ease": "swing" },
            { "t": 0.6, "v": [5], "ease": "swing" },
            { "t": 1.2, "v": [0], "ease": "swing" },

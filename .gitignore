node_modules/
# Spine example projects are fetched, not redistributed — see NOTICE.md
examples/
# Reference frames of the one example that ships no upstream license.txt, so its
# images carry no redistribution grant: rendering them locally is allowed (owner
# ruling 2026-08-26, issue #3), committing them never is. `render_reference.ts`
# refuses any --out inside this repository that this line does not cover, so the
# rule is enforced by `git check-ignore` rather than by remembering it.
/bench/reference-local/
# The cut table is the owning project's, not this repository's: it names paths
# into art that lives somewhere else. The selftest never picks one up implicitly
# — point a run at it with `--cuts <path>` or `RIGC_CUTS=<path>` — but a copy is
# convenient to keep here, so it stays ignored.
/cuts.json
.DS_Store
# `npm pack` output, from checking what a publish would ship.
/spine-rigc-*.tgz
# Where `rigc render` and `rigc preview` land by default. Running either from a
# checkout is the normal way to look at something, and neither output belongs to
# this repository — the reference frames that DO live here are under bench/.
/render/
/preview.html
# The gallery's examples ship their SOURCE — parts, rig, motion — and nothing
# built from it. Each README's commands write the skeleton, the frames and the
# preview beside the example so they can be run verbatim from a clean checkout,
# and these lines are what keeps doing that from dirtying the tree.
/gallery/*/build/
/gallery/*/render/
/gallery/*/preview.html
# The films (issue #342) keep their PIPELINE and nothing a run of it writes: the
# finished GIFs are the three in assets/, referenced from the READMEs rather than
# rebuilt into the tree. Two other kinds of file land here too and neither is
# repository material either — the art each film borrows, materialised at run
# time by its `run.sh` step 0b (film two takes film one's parts, film three takes
# `gallery/portrait`), and the specs a film's own generator writes. Everything
# below is reproducible by running the film; nothing below is authored here.
/films/*/bun.lock
# film one — art/parts and art/svg are `art/make_parts.ts`'s output, and the rig
# and motion specs are `spec/make_specs.ts`'s.
/films/one-assembly/art/parts/
/films/one-assembly/art/svg/
/films/one-assembly/art/mock.png
/films/one-assembly/spec/rigby.rig.json
/films/one-assembly/spec/rigby.motion.json
/films/one-assembly/build/
/films/one-assembly/render/
/films/one-assembly/gif/frames/
/films/one-assembly/rigc-demo.gif
/films/one-assembly/preview.html
# film two — art/ and two of spec/'s files are film one's, copied in by step 0b;
# the three motion specs are `spec/make_specs.ts`'s. vote/ keeps only its driver.
/films/two-keypose/art/
/films/two-keypose/spec/rigby.rig.json
/films/two-keypose/spec/skeleton.ts
/films/two-keypose/spec/poses.motion.json
/films/two-keypose/spec/cheer-a.motion.json
/films/two-keypose/spec/cheer-b.motion.json
/films/two-keypose/build-poses/
/films/two-keypose/build-cheer-a/
/films/two-keypose/build-cheer-b/
/films/two-keypose/render-poses/
/films/two-keypose/render-cheer-a/
/films/two-keypose/render-cheer-b/
/films/two-keypose/pose/
/films/two-keypose/vote/*
!/films/two-keypose/vote/drive.mjs
/films/two-keypose/gif/frames/
/films/two-keypose/gif/bits/
/films/two-keypose/gif/diff/
/films/two-keypose/gif/ab_strip.png
/films/two-keypose/rigc-keypose.gif
/films/two-keypose/preview.html
# film three — portrait-src/ is `gallery/portrait`, copied in by step 0b; the
# four logs are the film's own quoted sources, regenerated by every run.
/films/three-scene/portrait-src/
/films/three-scene/build/
/films/three-scene/render/
/films/three-scene/render-slow/
/films/three-scene/probe/
/films/three-scene/gif/frames/
/films/three-scene/gif/bits/
/films/three-scene/gif/verify/
/films/three-scene/*.log
/films/three-scene/rigc-scene.gif
/films/three-scene/preview.html

# Local-only preservation area — session artifacts, contact drafts, production sources.
# Never committed; see scratch/README.md inside it (also ignored).
/scratch/

# Agent worktrees the Claude Code harness creates inside the checkout while a squad works.
# Never committed; a squad's branch is what carries its work.
/.claude/worktrees/
